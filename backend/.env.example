# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database with pgvector
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jharkhand_innovation_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jharkhand_innovation_db

# Google Gemini API Configuration
GEMINI_API_KEY=AIzaSyYourCopiedKeyHere
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Legacy / OpenAI Configuration (Optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local ONNX Router Model Path
ONNX_MODEL_PATH=models/master_router.onnx
